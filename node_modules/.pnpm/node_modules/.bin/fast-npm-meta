#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/mnt/data/home/Dev/ledger-suit/node_modules/.pnpm/fast-npm-meta@2.2.0/node_modules/fast-npm-meta/node_modules:/mnt/data/home/Dev/ledger-suit/node_modules/.pnpm/fast-npm-meta@2.2.0/node_modules:/mnt/data/home/Dev/ledger-suit/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/mnt/data/home/Dev/ledger-suit/node_modules/.pnpm/fast-npm-meta@2.2.0/node_modules/fast-npm-meta/node_modules:/mnt/data/home/Dev/ledger-suit/node_modules/.pnpm/fast-npm-meta@2.2.0/node_modules:/mnt/data/home/Dev/ledger-suit/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../fast-npm-meta/dist/cli.mjs" "$@"
else
  exec node  "$basedir/../fast-npm-meta/dist/cli.mjs" "$@"
fi
