#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/mnt/data/home/Dev/ledger-suit/node_modules/.pnpm/nypm@0.6.9/node_modules/nypm/node_modules:/mnt/data/home/Dev/ledger-suit/node_modules/.pnpm/nypm@0.6.9/node_modules:/mnt/data/home/Dev/ledger-suit/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/mnt/data/home/Dev/ledger-suit/node_modules/.pnpm/nypm@0.6.9/node_modules/nypm/node_modules:/mnt/data/home/Dev/ledger-suit/node_modules/.pnpm/nypm@0.6.9/node_modules:/mnt/data/home/Dev/ledger-suit/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../nypm/dist/cli.mjs" "$@"
else
  exec node  "$basedir/../../../../nypm/dist/cli.mjs" "$@"
fi
